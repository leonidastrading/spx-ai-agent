# --- Alpaca (market data + news only; this app never trades) ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Optional: force a feed ("sip" or "iex"). Blank = probe sip, fall back to iex.
ALPACA_FEED=
# Set to true if your keys are paper keys (calendar/clock then use paper-api; still read-only).
ALPACA_PAPER=
# Optional client-side request cap per minute (default 190; Alpaca basic plan allows 200).
ALPACA_MAX_RPM=

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Optional, default claude-opus-5-5
CLAUDE_MODEL=

# --- Postgres (Neon / Vercel Postgres connection string) ---
DATABASE_URL=

# --- Email (Resend) ---
RESEND_API_KEY=
ALERT_EMAIL=
# Optional sender, default "Book advisor <onboarding@resend.dev>"
ALERT_FROM=

# --- Dashboard basic auth ---
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- Vercel cron auth (Vercel sends "Authorization: Bearer $CRON_SECRET") ---
CRON_SECRET=

# --- Paper accounts for the AI day trader and the swing sleeve ---
# Each needs its OWN Alpaca paper account (create extra paper accounts free in the
# Alpaca dashboard). Not the account any other bot trades, and not each other's.
# Paper keys only (PK...). There is no fallback to ALPACA_API_KEY_ID.
TRADER_ALPACA_KEY_ID=
TRADER_ALPACA_SECRET_KEY=
SWING_ALPACA_KEY_ID=
SWING_ALPACA_SECRET_KEY=

# --- Entry advisor (shadow mode): oo-trading's read-only export ---
# https://<oo-trading domain> (no path), and the token set there as OO_EXPORT_TOKEN.
OO_EXPORT_URL=
OO_EXPORT_TOKEN=
